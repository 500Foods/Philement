{
    "Server": {
        "ServerName": "hydrogen-test-26",
        "PayloadKey": "${env.PAYLOAD_KEY}"
    },
    "WebServer": {
        "EnableIPv4": true,
        "EnableIPv6": false,
        "Port": 5221,
        "Headers": [
            ["*", "Cross-Origin-Opener-Policy", "same-origin"],
            ["*", "Cross-Origin-Embedder-Policy", "require-corp"],
            [".wasm", "Cross-Origin-Resource-Policy", "same-origin"],
            [".js", "Cross-Origin-Resource-Policy", "same-origin"]
          ]
    },
    "API": {
        "Enabled": true,
        "Prefix": "/api"
    },
    "Swagger": {
        "Enabled": true,
        "Prefix": "/apidocs",
        "Metadata": {
            "Title": "Hydrogen Test API Two",
            "Description": "Test API for Swagger UI configuration 2",
            "Version": "2.0.0",
            "Contact": {
                "Name": "Test Contact Two",
                "Email": "contact2@test.com",
                "URL": "https://test2.example.com/contact"
            },
            "License": {
                "Name": "Apache-2.0",
                "URL": "https://www.apache.org/licenses/LICENSE-2.0"
            }
        },
        "UIOptions": {
            "TryItEnabled": true,
            "AlwaysExpanded": true,
            "DisplayOperationId": true,
            "DefaultModelsExpandDepth": 1,
            "DefaultModelExpandDepth": 1,
            "ShowExtensions": false,
            "ShowCommonExtensions": true,
            "DocExpansion": "list",
            "SyntaxHighlightTheme": "agate"
        }
    }
}