{
    "Server": {
        "ServerName": "hydrogen-test-30-firebird",
        "PayloadKey": "${env.PAYLOAD_KEY}"
    },
    "WebServer": {
        "EnableIPv4": true,
        "EnableIPv6": false,
        "Port": 5305
    },
    "Databases": {
        "ConnectionCount": 1,
        "Connections": [
            {
                "Enabled": true,
                "Name": "FB",
                "Engine": "firebird",
                "Host": "localhost",
                "Port": 3050,
                "Database": "${env.FIREBIRD_DB_PATH_DEMO}",
                "User": "SYSDBA",
                "Pass": "${env.FIREBIRD_SYSDBA_PASSWORD}",
                "Schema": "",
                "Bootstrap": "SELECT * FROM queries;",
                "Queues": {
                    "Slow": {
                        "start": 2
                    }
                }
            }
        ]
    }
}
