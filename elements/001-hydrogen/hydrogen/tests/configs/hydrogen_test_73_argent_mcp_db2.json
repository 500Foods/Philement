{
  "Server": {
    "ServerName": "hydrogen-test-73-argent-mcp-db2",
    "PayloadKey": "${env.PAYLOAD_KEY}"
  },
  "WebServer": {
    "EnableIPv4": true,
    "EnableIPv6": false,
    "Port": 15733
  },
  "Databases": {
    "Connections": [
      {
        "Enabled": true,
        "Name": "Acuranzo",
        "StmtCache": 100,
        "AutoMigration": true,
        "TestMigration": false,
        "Parameters": {
          "LOGINRETRYWINDOW": 15,
          "IPADDRESS": "10.10.10.10",
          "LOGINID": "${env.HYDROGEN_DEMO_USER_NAME}",
          "LOGINMAXATTEMPTS": 100000
        },
        "Migrations": "PAYLOAD:acuranzo+argent",
        "Queues": {
          "Slow": {
            "start": 2
          },
          "Medium": {
            "start": 4
          },
          "Fast": {
            "start": 4
          },
          "Cache": {
            "start": 2
          }
        },
        "Engine": "${env.HYDROTST_DB_TYPE}",
        "Database": "${env.HYDROTST_DB_NAME}",
        "Host": "localhost",
        "Port": 55555,
        "User": "${env.HYDROTST_DB_USER}",
        "Pass": "${env.HYDROTST_DB_PASS}",
        "Bootstrap": "SELECT query_id \"id\", query_ref \"ref\", query_status_a27 \"status\", query_type_a28 \"type\", query_dialect_a30 \"engine\", query_queue_a58 \"queue\", query_timeout \"timeout\", name \"name\", code \"query\" FROM demo.queries WHERE (query_status_a27 = 1) ORDER BY query_type_a28 desc;",
        "Schema": "demo"
      }
    ]
  },
  "Scripting": {
    "Enabled": true,
    "WorkerCount": 2,
    "Orchestrator": "Orchestrators.Orchestrator",
    "DefaultDatabase": "Acuranzo",
    "DefaultQueryTimeout": 60,
    "DefaultMaxRuntime": 3600,
    "InstructionHookInterval": 5000,
    "MemorySoftLimitKB": 32768,
    "MemoryHardLimitKB": 65536,
    "Sandbox": {
      "AllowOsTime": true,
      "AllowOsExecute": false,
      "AllowIo": false,
      "AllowDebug": false,
      "AllowLoadlib": false
    },
    "AllowDBModuleLoad": true
  },
  "API": {
    "Enabled": true,
    "Prefix": "/api",
    "JWTSecret": "${env.HYDROGEN_DEMO_JWT_KEY}"
  },
  "MCP": {
    "Enabled": true,
    "Interface": "127.0.0.1",
    "Port": 15743,
    "Path": "/mcp",
    "Protocol": "Mcp.Server",
    "RequireJWT": true,
    "AcceptHydrogenJWT": true,
    "AcceptOidcIdP": false,
    "AcceptOidcRp": false,
    "ThreadPoolSize": 4,
    "RequestTimeoutSeconds": 60,
    "MaxSessions": 256,
    "SessionIdleTimeoutSeconds": 900,
    "AllowedOrigins": []
  }
}
