{
    "Server": {
        "ServerName": "hydrogen-test-45-mssql",
        "PayloadKey": "${env.PAYLOAD_KEY}"
    },
    "WebServer": {
        "EnableIPv4": true,
        "EnableIPv6": false,
        "Port": 5458
    },
    "API": {
        "Enabled": true,
        "Prefix": "/api",
        "JWTSecret": "${env.HYDROGEN_DEMO_JWT_KEY}"
    },
    "OIDC": {
        "Enabled": true,
        "Issuer": "http://localhost:5458",
        "ClientId": "test-idp-public",
        "RedirectUri": "http://127.0.0.1:5459/cb",
        "Database": "Acuranzo",
        "Keys": {
            "StoragePath": "tests/artifacts/oidc_idp_keys_45_mssql",
            "EncryptionEnabled": false,
            "RotationIntervalDays": 90
        },
        "Tokens": {
            "AccessTokenLifetime": 3600,
            "RefreshTokenLifetime": 86400,
            "IdTokenLifetime": 3600,
            "SigningAlg": "RS256"
        }
    },
    "Databases": {
        "Connections": [
            {
                "Enabled": true,
                "Name": "Acuranzo",
                "Engine": "mssql",
                "Host": "${env.MSSQL_DB_HOST}",
                "Port": "${env.MSSQL_DB_PORT}",
                "Database": "${env.MSSQL_DB_NAME}",
                "User": "${env.MSSQL_DB_USER}",
                "Pass": "${env.MSSQL_SA_PASSWORD}",
                "StmtCache": 100,
                "Bootstrap": "SELECT query_id id, query_ref ref, query_status_a27 status, query_type_a28 type, query_dialect_a30 engine, query_queue_a58 queue, query_timeout timeout, name, code query FROM demoms.queries WHERE (query_status_a27 = 1) ORDER BY query_type_a28 desc;",
                "AutoMigration": true,
                "TestMigration": false,
                "Parameters": {
                    "LOGINRETRYWINDOW": 15,
                    "IPADDRESS": "10.10.10.16",
                    "LOGINID": "${env.HYDROGEN_DEMO_USER_NAME}"
                },
                "Schema": "demoms",
                "Migrations": "PAYLOAD:acuranzo",
                "Queues": {
                    "Slow": {
                        "start": 2
                    }
                }
            }
        ]
    }
}
