{
    "Server": {
        "ServerName": "hydrogen-test-27-reporting",
        "PayloadKey": "${env.PAYLOAD_KEY}"
    },
    "WebServer": {
        "EnableIPv4": true,
        "EnableIPv6": false,
        "Port": 5270
    },
    "API": {
        "Enabled": true,
        "Prefix": "/api",
        "JWTSecret": "${env.HYDROGEN_DEMO_JWT_KEY}"
    },
    "Swagger": {
        "Enabled": false
    },
    "Reporting": {
        "Enabled": true,
        "MaxImageSize": 8192,
        "MaxInputBytes": 9000000,
        "MaxOutputBytes": 9000000,
        "DefaultDPI": 72,
        "AllowedFormats": "jpg,jpeg,png,bmp,svg,ico,webp,xo"
    },
    "Databases": {
        "Connections": [
            {
                "Name": "Acuranzo",
                "Engine": "sqlite",
                "Enabled": true,
                "Database": "tests/artifacts/database/sqlite/hydrodemo.sqlite",
                "StmtCache": 100,
                "Bootstrap": "SELECT query_id id, query_ref ref, query_status_a27 status, query_type_a28 type, query_dialect_a30 engine, query_queue_a58 queue, query_timeout timeout, name, code query FROM queries WHERE (query_status_a27 = 1) ORDER BY query_type_a28 desc;",
                "AutoMigration": true,
                "TestMigration": false,
                "Parameters": {
                    "LOGINRETRYWINDOW": 15,
                    "IPADDRESS": "10.10.10.10",
                    "LOGINID": "${env.HYDROGEN_DEMO_USER_NAME}",
                    "LOGINMAXATTEMPTS": 100000
                },
                "Schema": "",
                "Migrations": "PAYLOAD:acuranzo",
                "Queues": {
                    "Slow": {
                        "start": 2
                    },
                    "Medium": {
                        "start": 2
                    },
                    "Fast": {
                        "start": 2
                    },
                    "Cache": {
                        "start": 1
                    }
                }
            }
        ]
    }
}
