{       
    "Server": {
        "ServerName": "hydrogen-test-26-terminal-filesystem",
        "PayloadKey": "${env.PAYLOAD_KEY}"
    },
    "WebServer": {
        "EnableIPv4": true,
        "EnableIPv6": true,
        "Port": 5262
    },
    "WebSocketServer": {
        "EnableIPv4": true,
        "EnableIPv6": true,
        "Port": 5263,
        "Protocol": "terminal",
        "Key": "${env.WEBSOCKET_KEY}",
        "PublicUrl": "wss://localhost:5263",
        "MaxMessageSize": 8192
    },
    "Terminal": {
        "Enabled": true,
        "WebRoot": "tests/artifacts/terminal",
        "ShellCommand": "/bin/zsh",
        "MaxSessions": 10,
        "IdleTimeoutSeconds": 300,
        "BufferSize": 1024,
        "CORSOrigin": "https://lithium.philement.com"
    },
    "API": {
        "Enabled": true,
        "Prefix": "/api"
    }
}
