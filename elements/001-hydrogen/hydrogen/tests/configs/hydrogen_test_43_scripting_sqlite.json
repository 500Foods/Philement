{
    "Server": {
        "ServerName": "hydrogen-test-43-scripting-sqlite",
        "PayloadKey": "${env.PAYLOAD_KEY}"
    },
    "WebServer": {
        "EnableIPv4": true,
        "EnableIPv6": false,
        "Port": 15432
    },
    "Databases": {
        "Connections": [
            {
                "Enabled": true,
                "Name": "Acuranzo",
                "Engine": "sqlite",
                "Database": "tests/artifacts/database/sqlite/hydrodemo.sqlite",
                "StmtCache": 100,
                "Bootstrap": "SELECT query_id id, query_ref ref, query_status_a27 status, query_type_a28 type, query_dialect_a30 engine, query_queue_a58 queue, query_timeout timeout, name, code query FROM queries WHERE (query_status_a27 = 1) ORDER BY query_type_a28 desc;",
                "AutoMigration": false,
                "TestMigration": false,
                "Parameters": {
                    "LOGINRETRYWINDOW": 15,
                    "IPADDRESS": "10.10.10.10",
                    "LOGINID": "${env.HYDROGEN_DEMO_USER_NAME}"
                },
                "Schema": "",
                "Migrations": "PAYLOAD:acuranzo",
                "Queues": {
                    "Slow": {
                        "start": 2
                    }
                }
            }
        ]
    },
    "Scripting": {
        "Enabled": true,
        "WorkerCount": 2,
        "Orchestrator": "Orchestrators.Orchestrator",
        "DefaultDatabase": "Acuranzo",
        "DefaultQueryTimeout": 30,
        "DefaultMaxRuntime": 3600,
        "InstructionHookInterval": 5000,
        "MemorySoftLimitKB": 32768,
        "MemoryHardLimitKB": 65536,
        "Sandbox": {
            "AllowOsTime": true,
            "AllowOsExecute": false,
            "AllowIo": false,
            "AllowDebug": false,
            "AllowLoadlib": false
        },
        "AllowDBModuleLoad": true
    },
    "MailRelay": {
        "Enabled": true,
        "OutboundEnabled": true,
        "InboundEnabled": false,
        "ListenPort": 25,
        "Workers": 1,
        "DefaultFrom": "mailrelay-test@hydrogen.local",
        "DefaultReplyTo": "mailrelay-test@hydrogen.local",
        "Queue": {
            "MaxQueueSize": 1000,
            "MaxInMemory": 1000,
            "Persist": false,
            "RetryAttempts": 1,
            "RetryDelaySeconds": 300,
            "InitialDelaySeconds": 60,
            "MaxDelaySeconds": 3600,
            "DebounceSeconds": 5,
            "StaleTimeoutSeconds": 300
        },
        "Servers": [
            {
                "Host": "127.0.0.1",
                "Port": "1",
                "UseTLS": false,
                "TLSMode": 0,
                "AuthMode": 0,
                "TimeoutSeconds": 5
            }
        ]
    }
}
