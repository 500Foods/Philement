{
    "Server": {
        "ServerName": "hydrogen-test-63-conduit-webhook-db2",
        "PayloadKey": "${env.PAYLOAD_KEY}"
    },
    "WebServer": {
        "EnableIPv4": true,
        "EnableIPv6": false,
        "Port": 15633
    },
    "Databases": {
        "Connections": [
            {
                "Enabled": true,
                "Name": "Acuranzo",
                "Engine": "${env.HYDROTST_DB_TYPE}",
                "Database": "${env.HYDROTST_DB_NAME}",
                "Host": "localhost",
                "Port": 55555,
                "StmtCache": 100,
                "User": "${env.HYDROTST_DB_USER}",
                "Pass": "${env.HYDROTST_DB_PASS}",
                "Bootstrap": "SELECT query_id \"id\", query_ref \"ref\", query_status_a27 \"status\", query_type_a28 \"type\", query_dialect_a30 \"engine\", query_queue_a58 \"queue\", query_timeout \"timeout\", name \"name\", code \"query\" FROM demo.queries WHERE (query_status_a27 = 1) ORDER BY query_type_a28 desc;",
                "AutoMigration": false,
                "TestMigration": false,
                "Migrations": "PAYLOAD:acuranzo",
                "Schema": "demo",
                "Parameters": {
                    "LOGINRETRYWINDOW": 15,
                    "IPADDRESS": "10.10.10.10",
                    "LOGINID": "${env.HYDROGEN_DEMO_USER_NAME}",
                    "LOGINMAXATTEMPTS": 100000
                },
                "Queues": {
                    "Slow": {
                        "start": 2
                    },
                    "Medium": {
                        "start": 4
                    },
                    "Fast": {
                        "start": 4
                    },
                    "Cache": {
                        "start": 2
                    }
                }
            }
        ]
    },
    "Scripting": {
        "Enabled": true,
        "WorkerCount": 2,
        "Orchestrator": "Orchestrators.Orchestrator",
        "DefaultDatabase": "Acuranzo",
        "DefaultQueryTimeout": 30,
        "DefaultMaxRuntime": 3600,
        "InstructionHookInterval": 5000,
        "MemorySoftLimitKB": 32768,
        "MemoryHardLimitKB": 65536,
        "Sandbox": {
            "AllowOsTime": true,
            "AllowOsExecute": false,
            "AllowIo": false,
            "AllowDebug": false,
            "AllowLoadlib": false
        },
        "AllowDBModuleLoad": true
    },
    "API": {
        "Enabled": true,
        "Prefix": "/api",
        "JWTSecret": "${env.HYDROGEN_DEMO_JWT_KEY}"
    },
    "Webhooks": {
        "Enabled": true,
        "Hooks": [
            {
                "Name": "echo",
                "SecretEnv": "HYDROGEN_TEST_WEBHOOK_SECRET",
                "SignatureHeader": "X-Signature-256",
                "Hmac": "sha256",
                "Script": "Api.Echo"
            },
            {
                "Name": "ts",
                "SecretEnv": "HYDROGEN_TEST_WEBHOOK_SECRET",
                "SignatureHeader": "X-Timestamp-Signature",
                "Hmac": "sha256-timestamp",
                "Script": "Api.Echo"
            },
            {
                "Name": "missing",
                "SecretEnv": "HYDROGEN_TEST_WEBHOOK_SECRET",
                "SignatureHeader": "X-Signature-256",
                "Hmac": "sha256",
                "Script": "No.SuchScript"
            },
            {
                "Name": "noenv",
                "SecretEnv": "HYDROGEN_TEST_WEBHOOK_SECRET_UNSET",
                "SignatureHeader": "X-Signature-256",
                "Hmac": "sha256",
                "Script": "Api.Echo"
            },
            {
                "Name": "nosig",
                "SecretEnv": "HYDROGEN_TEST_WEBHOOK_SECRET",
                "Hmac": "sha256",
                "Script": "Api.Echo"
            }
        ]
    }
}
