{       
    "Server": {
        "ServerName": "hydrogen-test-26-terminal-payload",
        "PayloadKey": "${env.PAYLOAD_KEY}"
    },
    "WebServer": {
        "EnableIPv4": true,
        "EnableIPv6": true,
        "Port": 5260
    },
    "WebSocketServer": {
        "EnableIPv4": true,
        "EnableIPv6": true,
        "Port": 5261,
        "Protocol": "hydrogen",
        "Key": "${env.WEBSOCKET_KEY}",
        "PublicUrl": "wss://localhost:5261",
        "MaxMessageSize": 8192
    },
    "Terminal": {
        "Enabled": true,
        "Protocol": "terminal",
        "Key": "${env.WEBSOCKET_TERMINAL_KEY}",
        "ShellCommand": "/bin/zsh",
        "MaxSessions": 10,
        "IdleTimeoutSeconds": 300,
        "BufferSize": 1024,
        "CORSOrigin": "https://lithium.philement.com"
    },
    "API": {
        "Enabled": true,
        "Prefix": "/api",
        "JWTSecret": "${env.HYDROGEN_DEMO_JWT_KEY}"
    },
    "Network": {
        "TrustedProxies": ["127.0.0.1/32", "::1/128"]
    },
    "Databases": {
        "Connections": [
            {
                "Name": "Acuranzo",
                "Engine": "sqlite",
                "Enabled": true,
                "Database": "tests/artifacts/database/sqlite/hydrodemo.sqlite",
                "StmtCache": 100,
                "Bootstrap": "SELECT query_id id, query_ref ref, query_status_a27 status, query_type_a28 type, query_dialect_a30 engine, query_queue_a58 queue, query_timeout timeout, name, code query FROM queries WHERE (query_status_a27 = 1) ORDER BY query_type_a28 desc;",
                "AutoMigration": true,
                "TestMigration": false,
                "Parameters": {
                    "LOGINRETRYWINDOW": 15,
                    "LOGINID": "${env.HYDROGEN_DEMO_USER_NAME}"
                },
                "Schema": "",
                "Migrations": "PAYLOAD:acuranzo",
                "Queues": {
                    "Slow": {
                        "start": 2
                    }
                }
            }
        ]
    }
}
