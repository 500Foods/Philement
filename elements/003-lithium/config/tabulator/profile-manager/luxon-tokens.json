      "title": "ID",
      "field": "id",
      "coltype": "string",
      "visible": false,
      "sort": true,
      "filter": false,
      "editable": false,
      "calculated": false,
      "primaryKey": true,
      "description": "Primary key (same as token)"
    },
    "group": {
      "title": "Group",
      "field": "group",
      "coltype": "string",
      "visible": true,
      "sort": true,
      "filter": true,
      "editable": false,
      "calculated": false,
      "primaryKey": false,
      "description": "Token category (Timezones, Years, Months, ...)",
      "width": 160
    },
    "token": {
      "title": "Token",
      "field": "token",
      "coltype": "string",
      "visible": true,
      "sort": true,
      "filter": true,
      "editable": false,
      "calculated": false,
      "primaryKey": false,
      "description": "Luxon format token",
