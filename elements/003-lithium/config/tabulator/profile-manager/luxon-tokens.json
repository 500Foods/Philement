    "example": {
      "title": "Sample",
      "field": "example",
      "coltype": "string",
      "visible": true,
      "sort": true,
      "filter": true,
      "editable": false,
      "calculated": false,
      "primaryKey": false,
      "description": "Token applied to the page's sample datetime",
      "width": 200
    },
    "current": {
      "title": "Current",
      "field": "current",
      "coltype": "string",
      "visible": true,
      "sort": true,
      "filter": true,
      "editable": false,
      "calculated": false,
      "primaryKey": false,
      "description": "Token applied to the current datetime",
      "width": 200
    }
