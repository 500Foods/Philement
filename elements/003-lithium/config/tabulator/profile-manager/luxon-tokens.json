{
  "$schema": "../tabledef-schema.json",
  "$version": "1.0.0",
  "$description": "Luxon format token reference on Profile > Date Formats. Lookup 059 key 16 (acuranzo_1409). Static rows built client-side by LuxonTokenTable.",
  "table": "luxon-tokens",
  "title": "Luxon Tokens",
  "queryRef": null,
  "readonly": true,
  "selectableRows": 1,
  "layout": "fitColumns",
  "responsiveLayout": "collapse",
